# Copy to .env.test for local tests. All values below are placeholders.
# Use a dedicated test database; never point tests at production.
NODE_ENV=test
PORT=3000
TZ=Asia/Ho_Chi_Minh
APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

DB_NAME=wedding_test
DB_USER=wedding_test
DB_PASSWORD=replace_with_local_test_database_password
DATABASE_URL=postgresql://wedding_test:replace_with_local_test_database_password@localhost:5432/wedding_test
DB_POOL_MIN=1
DB_POOL_MAX=5
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

BETTER_AUTH_SECRET=replace_with_a_random_test_secret_at_least_32_characters
GOOGLE_CLIENT_ID=your_test_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_test_google_client_secret
OWNER_EMAIL_1=groom@example.com
OWNER_EMAIL_2=bride@example.com

UPLOAD_DIR=./tests/tmp/uploads
MAX_UPLOAD_SIZE_BYTES=20971520
MAX_IMAGE_MEGAPIXELS=40
SHARP_CONCURRENCY=2
