# ==============================================================================
# Wedding Management System - Automated Test Environment
# ==============================================================================
NODE_ENV=test
PORT=3001
TZ=Asia/Ho_Chi_Minh

# Local / CI PostgreSQL Test Instance
DB_NAME=wedding_test
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wedding_test?sslmode=disable

# Minimal connection pool for test runner
DB_POOL_MIN=1
DB_POOL_MAX=5
DB_IDLE_TIMEOUT_MS=10000
DB_CONNECTION_TIMEOUT_MS=3000

# Test Auth Configuration
BETTER_AUTH_SECRET=test_secret_for_automated_test_suites_minimum_32_characters_long
BETTER_AUTH_URL=http://localhost:3001
GOOGLE_CLIENT_ID=test_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=test_google_client_secret

OWNER_EMAIL_1=test_owner1@example.com
OWNER_EMAIL_2=test_owner2@example.com

# Local temporary upload directory for test fixtures
UPLOAD_DIR=./tests/tmp/uploads
MAX_UPLOAD_SIZE_BYTES=20971520
MAX_IMAGE_MEGAPIXELS=40
SHARP_CONCURRENCY=1
