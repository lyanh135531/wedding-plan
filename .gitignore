# Dependencies and package caches (commit pnpm-lock.yaml)
node_modules/
.pnpm-store/
.pnpm-debug.log*

# Next.js output and generated TypeScript declarations
/.next*/
/out/
/dist/
/next-env.d.ts
*.tsbuildinfo

# Test output (keep source tests and their required fixtures)
/coverage/
/playwright-report/
/playwright/.cache/
/test-results/
/tests/tmp/
/all-test-results.json
/test-results.json
/test-summary.txt

# Environment files: only sanitized templates belong in Git
.env*
!.env.example
!.env.*.example
*.local
*.pem
*.key
*.p12
*.pfx

# Uploaded user data, database backups and local review artifacts
/uploads/
/data/
/backups/
/backups_test_temp/
/.local-artifacts/
/debug_db.*

# Local agent runtime
/.agents/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS and editor state
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
.idea/
*.swp
*.swo
