# ==============================================================================
# Wedding Management System - Production & Development Environment Template
# Timezone: Asia/Ho_Chi_Minh | Currency: VND (BigInt)
# ==============================================================================

# Node Runtime
NODE_ENV=production
PORT=3000
TZ=Asia/Ho_Chi_Minh

# Web Application Host Configuration
# MUST be HTTPS in production; used for OAuth callback and asset links
APP_URL=https://wedding.example.com
APP_PORT=3000

# PostgreSQL 16 Database Configuration
DB_NAME=wedding
DB_USER=wedding_bootstrap
DB_PASSWORD=replace_with_a_secure_database_password_min_32_chars
APP_DB_USER=wedding_app
APP_DB_PASSWORD=replace_with_a_different_secure_app_password_min_32_chars
DATABASE_URL=postgresql://wedding_app:replace_with_a_different_secure_app_password_min_32_chars@db:5432/wedding?sslmode=disable
MIGRATION_DATABASE_URL=postgresql://wedding_bootstrap:replace_with_a_secure_database_password_min_32_chars@db:5432/wedding?sslmode=disable

# Database Connection Pool Tuning
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# Better Auth & Google OAuth Credentials
# BETTER_AUTH_SECRET: generate via `openssl rand -hex 32`
BETTER_AUTH_SECRET=replace_with_64_character_hex_random_secret
BETTER_AUTH_URL=https://wedding.example.com
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace_with_your_google_oauth_client_secret

# The EXACT Two Pre-Authorized Wedding Owners (Seed Workflow)
OWNER_EMAIL_1=owner-one@example.invalid
OWNER_EMAIL_2=owner-two@example.invalid

# Media & Document Storage (Persistent Disk Mount Outside Web Root)
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_SIZE_BYTES=20971520 # 20MB limit
MAX_IMAGE_MEGAPIXELS=40
SHARP_CONCURRENCY=2

# Backup Staging Directory (Host Path)
BACKUP_STAGING_DIR=/srv/wedding/data/backup_staging
